# Database (Supabase Postgres + pgvector). Use the Supavisor "Transaction"
# pooler connection string (port 6543) from Project Settings > Database —
# required for serverless (Vercel) so each invocation doesn't open a raw
# TCP connection. The driver already sets prepare:false, which transaction
# mode requires.
DATABASE_URL=

# Embeddings — always Voyage, independent of the LLM provider below. Must
# match the model used by scripts/offline/index_embeddings.py so query-time
# and indexed vectors share the same space.
VOYAGE_API_KEY=

# LLM provider for generation: anthropic (default) | openrouter
LLM_PROVIDER=anthropic

# Provider credentials — set the one matching LLM_PROVIDER
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Model id. Optional for anthropic (defaults to claude-haiku-4-5-20251001).
# REQUIRED for openrouter — use a vendor/model slug from
# https://openrouter.ai/models, e.g. anthropic/claude-3.5-haiku
LLM_MODEL=

# RAG engine selection: langchain | llamaindex | vercel-ai | custom
DEFAULT_RAG_ENGINE=vercel-ai
